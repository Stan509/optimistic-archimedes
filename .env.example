# ========================================================================
# AeroLux Select — Environment Configuration Example (.env.example)
# Copy this file to .env and fill in your values.
# Ce fichier sert de documentation pour toutes les variables d'environnement.
# ========================================================================

# -----------------------------------------------------------------------
# DJANGO CORE
# -----------------------------------------------------------------------
DJANGO_SECRET_KEY='change-me-to-a-long-random-secret-key'

# Set 'False' in production, 'True' for development
DJANGO_DEBUG='True'

# Comma-separated list of allowed hosts (e.g. .aeroluxselect.com,localhost)
DJANGO_ALLOWED_HOSTS='*'

# Comma-separated list of CSRF trusted origins (e.g. https://aeroluxselect.com)
CSRF_TRUSTED_ORIGINS=''

# -----------------------------------------------------------------------
# DATABASE — Default: SQLite. For production, use PostgreSQL via DATABASE_URL
# -----------------------------------------------------------------------
# Example PostgreSQL on DigitalOcean App Platform:
# DATABASE_URL='postgres://user:password@host:port/dbname?sslmode=require'
DATABASE_URL=''


# ========================================================================
# GOOGLE APIs — All are OPTIONAL. Leave empty to disable the feature.
# ========================================================================

# -----------------------------------------------------------------------
# [OPTION 1] GOOGLE MAPS API — Free tier: 28,000 loads/month
# Requires: API key from https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------
# Global key — used by all sites if site-specific keys below are empty
GOOGLE_MAPS_API_KEY=''

# Per-site specific keys (overrides the global key above)
GOOGLE_MAPS_API_KEY_NYC=''
GOOGLE_MAPS_API_KEY_DR=''

# When Google Maps key is empty, Leaflet.js (OpenStreetMap) is used as
# a free alternative that requires NO API key.

# -----------------------------------------------------------------------
# [OPTION 2] GOOGLE reCAPTCHA — Free anti-bot/spam protection
# Requires: Keys from https://www.google.com/recaptcha/admin (v3 recommended)
# -----------------------------------------------------------------------
RECAPTCHA_SITE_KEY=''
RECAPTCHA_SECRET_KEY=''

# -----------------------------------------------------------------------
# [OPTION 3] GOOGLE ANALYTICS 4 (GA4) — Free website traffic analytics
# Requires: Measurement ID from https://analytics.google.com (format: G-XXXXXXXXXX)
# -----------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=''

# -----------------------------------------------------------------------
# [OPTION 4] GOOGLE TAG MANAGER — Free tag management
# Requires: Container ID from https://tagmanager.google.com (format: GTM-XXXXXXX)
# -----------------------------------------------------------------------
GTM_CONTAINER_ID=''


# ========================================================================
# DIGITALOCEAN SPACES (S3-compatible storage for media files in production)
# ========================================================================
DO_SPACES_KEY=''
DO_SPACES_SECRET=''
DO_SPACES_BUCKET='aeroluxe-media'
DO_SPACES_REGION='nyc3'
DO_SPACES_ENDPOINT=''
DO_SPACES_CDN=''


# ========================================================================
# STRIPE — Payment processing (optional, configurable from dashboard)
# ========================================================================
STRIPE_PUBLIC_KEY=''
STRIPE_SECRET_KEY=''